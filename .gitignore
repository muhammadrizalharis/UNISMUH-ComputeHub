# ==========================================================================
#  UNISMUH ComputeHub — root .gitignore (jaring pengaman)
#  Rahasia & artefak besar TIDAK boleh masuk repo.
# ==========================================================================

# --- Rahasia / environment ---
# TANPA pengecualian untuk .env.example: berkas contoh mudah terisi nilai asli
# saat disalin, dan sekali ter-commit ia menetap di riwayat git selamanya.
# Daftar kunci yang dibutuhkan didokumentasikan di README, bukan sebagai .env*.
**/.env
**/.env.local
*.env
**/.env.*

# --- Python ---
**/__pycache__/
*.py[cod]
**/.venv/
**/venv/
**/*.egg-info/

# --- Node / frontend ---
**/node_modules/
**/dist/
npm-debug.log*
yarn-error.log*

# --- Database (SQLite) ---
*.db
*.db-wal
*.db-shm
*.sqlite3

# --- Runtime data ---
backend/_jobs/
backend/_alerts/
*.log
logs/

# --- IDE / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db

# Agen kesehatan jaringan lokal (rahasia, di luar repo)
scripts/telebot.py
scripts/net-health-agent.py
