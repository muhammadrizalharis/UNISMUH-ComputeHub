[Unit]
Description=ComputeHub Devbox (cadangan VRAM untuk user ComputeHub)
OnFailure=computehub-failure-alert@%n.service

[Service]
Type=simple
Nice=10
ExecStart=/usr/bin/python3 %h/DATA_ICAL/SERVER-KAMPUS/scripts/computehub_devbox.py
Restart=always
RestartSec=5
# SIGTERM -> daemon melepas semua VRAM lalu keluar.
KillSignal=SIGTERM
TimeoutStopSec=20

[Install]
WantedBy=default.target
