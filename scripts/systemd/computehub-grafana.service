[Unit]
Description=ComputeHub Grafana (dashboard observability)
After=network-online.target computehub-prometheus.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
# Bersihkan sisa container bila unit mati tak wajar (abaikan galat bila tak ada).
ExecStartPre=-/usr/bin/sudo -n /usr/bin/docker rm -f computehub-grafana
# Kredensial admin dibaca dari file env di luar git (berisi password).
# --network host + GF_SERVER_HTTP_ADDR=127.0.0.1: Grafana HANYA di localhost:3300
# (akses via SSH tunnel / reverse proxy). Datasource Prometheus = localhost:9090.
# --user 1015: data Grafana di ~/.computehub/observability/grafana-data milik host.
ExecStart=/usr/bin/sudo -n /usr/bin/docker run --rm --name computehub-grafana \
  --init --network host --user 1015:1015 \
  --env-file /home/muhammadrizalharis/.computehub/observability/grafana.env \
  -e TZ=Asia/Makassar \
  -e GF_SERVER_HTTP_ADDR=127.0.0.1 \
  -e GF_SERVER_HTTP_PORT=3300 \
  -e GF_ANALYTICS_REPORTING_ENABLED=false \
  -e GF_ANALYTICS_CHECK_FOR_UPDATES=false \
  -e GF_USERS_ALLOW_SIGN_UP=false \
  -e GF_PATHS_PROVISIONING=/etc/grafana/provisioning \
  -v /home/muhammadrizalharis/DATA_ICAL/SERVER-KAMPUS/scripts/observability/grafana/provisioning:/etc/grafana/provisioning:ro \
  -v /home/muhammadrizalharis/DATA_ICAL/SERVER-KAMPUS/scripts/observability/grafana/dashboards:/etc/grafana/dashboards:ro \
  -v /home/muhammadrizalharis/.computehub/observability/grafana-data:/var/lib/grafana \
  grafana/grafana:latest
ExecStop=/usr/bin/sudo -n /usr/bin/docker stop -t 10 computehub-grafana
Restart=always
RestartSec=10
TimeoutStopSec=20

[Install]
WantedBy=default.target
