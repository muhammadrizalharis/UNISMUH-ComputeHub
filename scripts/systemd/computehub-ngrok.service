[Unit]
Description=ngrok tunnel - ComputeHub backend (localhost:8088 -> domain statis ngrok)
After=network-online.target computehub.service
Wants=network-online.target

[Service]
Type=simple
# Domain statis disimpan di luar repo: %h/.computehub/ngrok.env berisi
# NGROK_DOMAIN=nama-domain.ngrok-free.dev
EnvironmentFile=%h/.computehub/ngrok.env
ExecStart=%h/bin/ngrok http 8088 --domain=${NGROK_DOMAIN} --log=stdout --log-format=logfmt
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
