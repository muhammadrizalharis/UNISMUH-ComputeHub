{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "liveNow": false,
  "schemaVersion": 39,
  "tags": ["computehub"],
  "timezone": "browser",
  "title": "ComputeHub — Backend Overview",
  "uid": "computehub-backend",
  "version": 1,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "templating": { "list": [] },
  "panels": [
    {
      "type": "row",
      "title": "Lalu lintas HTTP",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Request rate (req/s) per status",
      "datasource": { "type": "prometheus", "uid": "computehub-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "computehub-prom" },
          "expr": "sum by (status) (rate(computehub_http_requests_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latensi (p50 / p95 / p99)",
      "datasource": { "type": "prometheus", "uid": "computehub-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "fillOpacity": 5 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "computehub-prom" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(computehub_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "computehub-prom" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(computehub_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "computehub-prom" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(computehub_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Request/s (total)",
      "datasource": { "type": "prometheus", "uid": "computehub-prom" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "computehub-prom" },
          "expr": "sum(rate(computehub_http_requests_total[5m]))"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Error rate 5xx (%)",
      "datasource": { "type": "prometheus", "uid": "computehub-prom" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "percent", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 1 }, { "color": "red", "value": 5 } ] } }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "computehub-prom" },
          "expr": "100 * sum(rate(computehub_http_requests_total{status=~\"5..\"}[5m])) / clamp_min(sum(rate(computehub_http_requests_total[5m])), 0.001)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Request sedang diproses",
      "datasource": { "type": "prometheus", "uid": "computehub-prom" },
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 20 } ] } }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "computehub-prom" },
          "expr": "computehub_http_requests_in_progress"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Uptime proses",
      "datasource": { "type": "prometheus", "uid": "computehub-prom" },
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "computehub-prom" },
          "expr": "time() - process_start_time_seconds"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Top endpoint (req/s)",
      "datasource": { "type": "prometheus", "uid": "computehub-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "computehub-prom" },
          "expr": "topk(10, sum by (path) (rate(computehub_http_requests_total[5m])))",
          "legendFormat": "{{path}}"
        }
      ]
    },
    {
      "type": "row",
      "title": "Proses backend",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "CPU proses (core)",
      "datasource": { "type": "prometheus", "uid": "computehub-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "computehub-prom" },
          "expr": "rate(process_cpu_seconds_total[5m])",
          "legendFormat": "cpu cores"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Memori proses (RSS)",
      "datasource": { "type": "prometheus", "uid": "computehub-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "computehub-prom" },
          "expr": "process_resident_memory_bytes",
          "legendFormat": "RSS"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "File descriptor terbuka",
      "datasource": { "type": "prometheus", "uid": "computehub-prom" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "fieldConfig": { "defaults": { "unit": "short", "custom": { "drawStyle": "line", "fillOpacity": 5 } }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "computehub-prom" },
          "expr": "process_open_fds",
          "legendFormat": "open fds"
        }
      ]
    }
  ]
}
